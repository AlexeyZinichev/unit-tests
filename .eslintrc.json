{
  "env": {
    "es2021": true,
    "node": true,
    "jest": true
  },
  "extends": [
    "airbnb-base"
  ],
  "parserOptions": {
    "ecmaVersion": 12,
    "sourceType": "module"
  },
  "rules": {
    "no-console": "off",
    "func-names": "off",
    "object-curly-newline": "off",
    "import/no-extraneous-dependencies": "off",
    "import/prefer-default-export": "off", // Запятая здесь тоже нужна для будущих правил
    "comma-dangle": "off" // Можно отключить правило, если запятые раздражают
  }
}